rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function farmerPath(uid) {
      return /databases/$(database)/documents/farmers/$(uid);
    }

    function centerPath(centerId) {
      return /databases/$(database)/documents/centers/$(centerId);
    }

    function tokenPath(id) {
      return /databases/$(database)/documents/tokens/$(id);
    }

    function purchasePath(id) {
      return /databases/$(database)/documents/purchases/$(id);
    }

    function notificationPath(id) {
      return /databases/$(database)/documents/notifications/$(id);
    }

    function callerExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function caller() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActiveFarmer() {
      return callerExists()
        && caller().role == 'farmer'
        && caller().status == 'active';
    }

    function isActiveCenter() {
      return callerExists()
        && caller().role == 'center'
        && caller().status == 'active'
        && caller().centerId is string;
    }

    function isActiveGov() {
      return callerExists()
        && caller().role == 'gov'
        && caller().status == 'active';
    }

    function callerCenterId() {
      return caller().centerId;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      // Allows the account to discover its own profile even when the doc is
      // not present yet (for example a first-time Google/phone-only session).
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      // Only a farmer can self-provision a profile from the public signup UI.
      // Center and Government accounts are created by Admin SDK/server flows.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'farmer'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.language in ['hi', 'en']
        && request.resource.data.theme in ['light', 'dark']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && (
          (
            request.resource.data.authProvider == 'password'
            && request.resource.data.keys().hasAll([
              'uid','role','name','username','authProvider','language','theme','status','createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'uid','role','name','username','authProvider','language','theme','status','createdAt'
            ])
            && request.resource.data.username is string
            && request.resource.data.username.matches('^[a-z0-9._-]{3,30}$')
          ) ||
          (
            request.resource.data.authProvider == 'google'
            && request.resource.data.keys().hasAll([
              'uid','role','name','email','authProvider','language','theme','status','createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'uid','role','name','email','photo','authProvider','language','theme','status','createdAt'
            ])
            && request.resource.data.email is string
            && request.resource.data.email.size() > 0
            && request.resource.data.email.size() <= 320
            && (request.resource.data.photo is string || request.resource.data.photo == null)
          )
        )
      // A Center account's users/{uid} doc is instead created by an
      // active Government caller, on behalf of a different uid (the new
      // Center's own Firebase Auth uid — see the "Spark-plan center
      // registration" note on /centers/{centerId} below for why this is
      // a plain client write rather than an Admin SDK operation, and
      // exactly what that does and doesn't secure).
      || (
        isActiveGov()
        && request.resource.data.uid == uid
        && request.resource.data.role == 'center'
        && request.resource.data.status == 'active'
        && request.resource.data.mustChangePassword == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.language in ['hi', 'en']
        && request.resource.data.theme in ['light', 'dark']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.authProvider == 'password'
        && request.resource.data.centerId is string
        && request.resource.data.centerId.matches('^[A-Z0-9]{2,12}$')
        && request.resource.data.adminId is string
        && request.resource.data.adminId.matches('^[a-z0-9._-]{3,20}$')
        && request.resource.data.keys().hasOnly([
          'uid','role','name','centerId','adminId','authProvider','language','theme','status','mustChangePassword','createdAt'
        ])
      );

      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          (
            onlyChanged(['theme','language'])
            && request.resource.data.theme in ['light','dark']
            && request.resource.data.language in ['hi','en']
          ) ||
          (
            onlyChanged(['mustChangePassword'])
            && resource.data.mustChangePassword == true
            && request.resource.data.mustChangePassword == false
          )
        );

      allow delete: if false;
    }

    match /farmers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && isActiveFarmer()
        && request.resource.data.keys().hasAll([
          'name','mobile','country','state','stateCode','district','districtCode',
          'block','blockCode','village','villageCode','latitude','longitude',
          'mainCrops','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name','username','email','mobile','country','state','stateCode',
          'district','districtCode','block','blockCode','village','villageCode',
          'latitude','longitude','mainCrops','createdAt','updatedAt'
        ])
        && request.resource.data.name == caller().name
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.country == 'India'
        && request.resource.data.stateCode is string
        && request.resource.data.stateCode.size() > 0
        && request.resource.data.districtCode is string
        && request.resource.data.districtCode.size() > 0
        && request.resource.data.mainCrops is list
        && request.resource.data.mainCrops.size() > 0
        && request.resource.data.mainCrops.size() <= 50
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    match /centers/{centerId} {
      allow get: if isActiveGov()
        || (isActiveFarmer()
          && resource.data.districtCode == get(farmerPath(request.auth.uid)).data.districtCode)
        || (isActiveCenter() && callerCenterId() == centerId);

      allow list: if isActiveGov()
        || (isActiveFarmer()
          && resource.data.districtCode == get(farmerPath(request.auth.uid)).data.districtCode
          && request.query.limit <= 20);

      // Spark-plan center registration: Government's browser tab writes
      // this document directly (no Cloud Function/Admin SDK on this
      // plan). The one thing rules genuinely cannot police is whether
      // the *Firebase Auth account* for this center was created by a
      // real Government user — Auth account creation is a client SDK
      // call gated only by the project's "Email/Password sign-in"
      // toggle, not by these rules. What these rules DO strictly
      // guarantee, regardless of who or what created any Auth account:
      // only an active Government caller may ever create a document
      // here, its centerId is pinned to this exact path segment,
      // required fields must be well-formed, and it always starts
      // govStatus:'active', status:'closed' — no one can create a
      // pre-activated or pre-opened center, and a stray Auth account
      // with no matching Government-authored doc here can never read or
      // write anything center-scoped (see isActiveCenter()).
      allow create: if isActiveGov()
        && request.resource.data.centerId == centerId
        && request.resource.data.centerName is string
        && request.resource.data.centerName.size() > 0
        && request.resource.data.centerName.size() <= 160
        && request.resource.data.centerCode is string
        && request.resource.data.centerCode.matches('^[A-Z0-9]{2,12}$')
        && request.resource.data.registeredMobile is string
        && request.resource.data.registeredMobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.country == 'India'
        && request.resource.data.stateCode is string
        && request.resource.data.stateCode.size() > 0
        && request.resource.data.districtCode is string
        && request.resource.data.districtCode.size() > 0
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 0
        && request.resource.data.counters is int
        && request.resource.data.counters >= 1
        && request.resource.data.counters <= 8
        && request.resource.data.acceptedCrops is list
        && request.resource.data.govStatus == 'active'
        && request.resource.data.status == 'closed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasAll([
          'centerId','centerName','centerCode','registeredMobile','country','state','stateCode',
          'district','districtCode','capacity','counters','acceptedCrops','govStatus','status','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'centerId','centerName','centerCode','registeredMobile','address','country','state','stateCode',
          'district','districtCode','block','blockCode','village','villageCode',
          'capacity','counters','acceptedCrops','govStatus','status','createdAt'
        ]);

      // Center operators control only their operational status and counter
      // count, and only while Government has the center activated.
      allow update: if isActiveCenter()
        && callerCenterId() == centerId
        && resource.data.govStatus == 'active'
        && onlyChanged(['status','counters'])
        && request.resource.data.status in ['open','closed']
        && request.resource.data.counters is int
        && request.resource.data.counters >= 1
        && request.resource.data.counters <= 8;

      allow delete: if false;
    }

    match /tokens/{tokenId} {
      // The farmer branch is intentionally based only on the path segment
      // (tokenId == request.auth.uid), never on resource.data. Because the
      // token document ID is always this farmer's own uid (see the create/
      // update rules below), that comparison alone proves ownership and
      // needs no read of the document's fields — which matters because
      // `resource` is null when the document does not exist yet, and
      // touching `resource.data` on a null resource throws and gets
      // denied. That was the actual bug: the old farmer branch read
      // `resource.data.farmerId`, so a farmer's very first pre-booking
      // check (get on their own not-yet-created token) always failed with
      // permission-denied, before setDoc() was ever attempted. This branch
      // fixes that: `get` on tokens/{ownUid} now always succeeds for an
      // active farmer, returning either the real document or "not found"
      // — never a permission error — regardless of whether it exists.
      // The center branch is unchanged: a center has no deterministic
      // relationship to a token's ID, so it can only prove ownership by
      // reading the existing document's centerId, which requires the
      // document (and therefore `resource`) to actually exist.
      allow get: if signedIn() && (
        (isActiveFarmer() && tokenId == request.auth.uid) ||
        (isActiveCenter() && resource.data.centerId == callerCenterId())
      );

      allow list: if signedIn() && (
        (isActiveFarmer() && resource.data.farmerId == request.auth.uid) ||
        (isActiveCenter() && resource.data.centerId == callerCenterId())
      );

      // Spark-plan farmer token booking: the farmer's own browser tab
      // writes this document directly (no Cloud Function/Admin SDK on
      // this plan). The document ID is pinned to the farmer's own uid
      // (see {tokenId} below), which is what makes "only one active
      // waiting token per farmer" atomic without a transaction: Firestore
      // classifies a write to an already-existing document as an
      // "update", never a "create", so a second booking attempt while a
      // token is still "waiting" is evaluated against `allow update`
      // below, whose booking branch requires `resource.data.status !=
      // 'waiting'` — so it's rejected exactly when, and only when, this
      // farmer already has a live waiting token. Once resolved (this
      // farmer cancelled it, or it reaches 'done'/'noshow' through the
      // center transition rule above) the very same rule lets the farmer book again
      // by overwriting this document with a brand-new, fully-revalidated
      // booking — same checks as a first-time create. Rules alone cannot
      // enforce a database-wide uniqueness constraint across arbitrary
      // document IDs; pinning the ID to the farmer's uid, plus branching
      // on resource.data.status, is what sidesteps that limitation
      // instead of requiring a transaction.
      function validBooking() {
        return request.resource.data.farmerId == request.auth.uid
          && request.resource.data.farmerName == caller().name
          && request.resource.data.status == 'waiting'
          && request.resource.data.centerId is string
          && get(centerPath(request.resource.data.centerId)).data.govStatus == 'active'
          && get(centerPath(request.resource.data.centerId)).data.status == 'open'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // bookingId: unique per booking. tokens/{uid} is reused across
          // bookings, so purchase / notification document IDs are derived
          // from uid + bookingId (see /purchases below).
          && request.resource.data.bookingId is string
          && request.resource.data.bookingId.matches('^[A-Za-z0-9_-]{20,64}$')
          // declaredCrops: { cropCode: expectedQuintal }. Keys must all be
          // crops this center accepts; 1..3 crops (keep in sync with
          // MAX_CROPS_PER_TOKEN in app.js). LIMITATION: rules cannot loop
          // over map values, so each quantity's type/range is only checked
          // client-side. It is a non-financial estimate: the center enters
          // the real weight, and /purchases pins declaredQuantity to it.
          && request.resource.data.declaredCrops is map
          && request.resource.data.declaredCrops.size() >= 1
          && request.resource.data.declaredCrops.size() <= 3
          && request.resource.data.declaredCrops.keys().hasOnly(
               get(centerPath(request.resource.data.centerId)).data.acceptedCrops)
          && request.resource.data.keys().hasAll([
            'farmerId','farmerName','centerId','status','bookingId','declaredCrops','createdAt','updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'farmerId','farmerName','centerId','status','bookingId','declaredCrops','createdAt','updatedAt'
          ]);
      }

      // Center-side token transitions (Spark plan: direct client writes).
      // A center may move a token of ITS OWN center from 'waiting' to
      //   - 'noshow': changes only status + updatedAt, nothing else needed;
      //   - 'done'  : only if, in the SAME batched write, the booking's
      //               notification document is created (existsAfter). That
      //               notification's own rule in turn requires the primary
      //               purchase to be created in the same batch, so a token
      //               can never reach 'done' without at least one valid
      //               purchase. See /purchases and /notifications.
      // A farmer can never reach either branch (role must be 'center').
      // The users/{uid} profile is read exactly once (let) to keep the
      // rules-call budget of the batched write small and deterministic.
      function centerMayTransition(tid) {
        let me = get(userPath(request.auth.uid)).data;
        return me.role == 'center'
          && me.status == 'active'
          && me.centerId is string
          && resource.data.centerId == me.centerId
          && resource.data.status == 'waiting'
          && onlyChanged(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            request.resource.data.status == 'noshow'
            || (
              request.resource.data.status == 'done'
              && existsAfter(notificationPath(tid + '_' + resource.data.bookingId))
            )
          );
      }

      allow create: if isActiveFarmer()
        && tokenId == request.auth.uid
        && validBooking();

      // Two, and only two, update paths for a farmer's own token document:
      //  1. Cancel: resource.data.status == 'waiting' -> 'cancelled',
      //     touching only status + updatedAt. A farmer can never
      //     resurrect or replay an already-finished token this way,
      //     since it requires the token to currently be 'waiting'.
      //  2. Rebook: resource.data.status != 'waiting' (this farmer's
      //     previous token was cancelled, or is otherwise resolved) and
      //     the new document is a full, freshly-revalidated booking —
      //     exactly the same checks a brand-new create would need. This
      //     is what lets a farmer book again after cancelling, without
      //     ever allowing it while a token is still live.
      // In both paths, `tokenId == request.auth.uid` and
      // `resource.data.farmerId == request.auth.uid` pin the write to
      // this farmer's own token — belt-and-suspenders, since the ID is
      // already pinned to the farmer's uid at create time.
      // Center transition first: when it passes, the farmer rule below is
      // never evaluated, which keeps the batched-write rule-call count low.
      allow update: if signedIn() && centerMayTransition(tokenId);

      allow update: if isActiveFarmer()
        && tokenId == request.auth.uid
        && resource.data.farmerId == request.auth.uid
        && (
          (
            resource.data.status == 'waiting'
            && onlyChanged(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.updatedAt == request.time
          ) ||
          (
            resource.data.status != 'waiting'
            && validBooking()
            // a rebook must carry a brand-new bookingId, so an old
            // booking's purchase IDs can never be reused or replayed
            && request.resource.data.bookingId != resource.data.get('bookingId', '')
          )
        );

      // Deleting a token document (e.g. to fully clear the slot) remains
      // server-controlled — a farmer only ever cancels or rebooks, never
      // deletes, and centers/gov have no rights here yet either.
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Purchases (Spark plan: created by the center's browser, no server).
    //
    // What these rules DO guarantee:
    //  * only an active, gov-active center can create, and only for a token
    //    of its own center that is 'waiting' and is moved to 'done' in the
    //    SAME batched write (getAfter) -> purchase, notification and token
    //    status change commit atomically or not at all;
    //  * farmerId / farmerName / centerId / centerName / bookingId /
    //    declaredQuantity are pinned to the token and center documents;
    //  * document ID = tokenId_bookingId_crop -> at most one purchase per
    //    crop per booking, ever (a second create is an update -> denied);
    //  * amount == quantity * rate (0.01 tolerance for float rounding),
    //    grade in A/B/C, sane caps, crop must be declared by the farmer AND
    //    accepted by the center;
    //  * no update / delete afterwards.
    // What they CANNOT guarantee (unlike the old Admin-SDK function):
    //  * the center itself chooses weight and rate (no server price table);
    //  * a malicious ACTIVE center can still fabricate purchases against
    //    its own waiting tokens; there is no rate limiting;
    //  * rules can't loop, so "every declared crop was handled" is not
    //    enforced, only "at least one valid purchase exists" (via the
    //    notification's primaryCrop).
    // Rules-call budget: this rule uses 4 document reads per purchase, the
    // notification 4, the token update 2 -> 18 of the 20 allowed for a
    // batched write when a token has 3 purchase lines (MAX_CROPS_PER_TOKEN).
    // ------------------------------------------------------------------
    match /purchases/{purchaseId} {
      function validPurchase(pid) {
        let d = request.resource.data;
        let me = get(userPath(request.auth.uid)).data;
        let tk = get(tokenPath(d.tokenId)).data;
        let ce = get(centerPath(me.centerId)).data;
        return me.role == 'center'
          && me.status == 'active'
          && me.centerId is string
          && d.keys().hasAll([
            'farmerId','farmerName','centerId','centerName','tokenId','bookingId','crop',
            'quantity','declaredQuantity','rate','grade','amount','paymentStatus','purchaseDate'
          ])
          && d.keys().hasOnly([
            'farmerId','farmerName','centerId','centerName','tokenId','bookingId','crop',
            'quantity','declaredQuantity','rate','grade','amount','paymentStatus','purchaseDate'
          ])
          && d.tokenId is string
          && d.bookingId is string
          && d.crop is string
          && d.crop.size() > 0
          && d.crop.size() <= 60
          && !d.crop.matches('.*/.*')
          && pid == d.tokenId + '_' + d.bookingId + '_' + d.crop
          // the token: this center's, still waiting, and moving to done now
          && d.tokenId == d.farmerId
          && tk.farmerId == d.farmerId
          && tk.centerId == me.centerId
          && tk.status == 'waiting'
          && tk.bookingId == d.bookingId
          && getAfter(tokenPath(d.tokenId)).data.status == 'done'
          && tk.farmerName == d.farmerName
          // the center
          && d.centerId == me.centerId
          && ce.govStatus == 'active'
          && d.centerName == ce.centerName
          && d.crop in ce.acceptedCrops
          // the farmer declared this crop; declaredQuantity is copied, not typed
          && d.crop in tk.declaredCrops.keys()
          && d.declaredQuantity is number
          && d.declaredQuantity == tk.declaredCrops[d.crop]
          // money
          && d.quantity is number && d.quantity > 0 && d.quantity <= 5000
          && d.rate is number && d.rate > 0 && d.rate <= 100000
          && d.grade in ['A', 'B', 'C']
          && d.amount is number
          && math.abs(d.amount - (d.quantity * d.rate)) <= 0.01
          && d.paymentStatus == 'pending'
          && d.purchaseDate == request.time;
      }

      allow get: if (isActiveFarmer() && resource.data.farmerId == request.auth.uid)
        || (isActiveCenter() && resource.data.centerId == callerCenterId());
      allow list: if (isActiveFarmer() && resource.data.farmerId == request.auth.uid)
        || (isActiveCenter() && resource.data.centerId == callerCenterId());

      allow create: if signedIn() && validPurchase(purchaseId);
      allow update, delete: if false;
    }

    // Notifications. A center may NOT write free text to a farmer: the only
    // client-creatable notification is the fixed-shape 'token_served'
    // record below (no `text` field; the app builds the sentence from
    // `type`). Its ID is tokenId_bookingId, so each booking can produce it
    // once, and it must be created in the same batch that moves that
    // booking's token to 'done' together with a valid primary purchase.
    match /notifications/{notificationId} {
      function validServedNotification(nid) {
        let d = request.resource.data;
        let me = get(userPath(request.auth.uid)).data;
        let tk = get(tokenPath(d.userId)).data;
        let ce = get(centerPath(me.centerId)).data;
        return me.role == 'center'
          && me.status == 'active'
          && me.centerId is string
          && d.keys().hasAll(['userId','type','centerId','centerName','bookingId','primaryCrop','createdAt'])
          && d.keys().hasOnly(['userId','type','centerId','centerName','bookingId','primaryCrop','createdAt'])
          && d.type == 'token_served'
          && d.userId is string
          && d.bookingId is string
          && d.primaryCrop is string
          && d.primaryCrop.size() > 0
          && d.primaryCrop.size() <= 60
          && !d.primaryCrop.matches('.*/.*')
          && nid == d.userId + '_' + d.bookingId
          && d.centerId == me.centerId
          && d.centerName == ce.centerName
          && tk.farmerId == d.userId
          && tk.centerId == me.centerId
          && tk.status == 'waiting'
          && tk.bookingId == d.bookingId
          && existsAfter(purchasePath(d.userId + '_' + d.bookingId + '_' + d.primaryCrop))
          && d.createdAt == request.time;
      }

      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validServedNotification(notificationId);
      allow update, delete: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
